# Build output
/bin/
/schematool
# Stray binaries from a hand-run `go build .` at the repo root; `make` puts
# them in bin/.
/server
/bankctl
/wenyuan

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/

# Environment
.env
.env.*
!.env.example

# Source runs ('make dev-restart'): PID files and logs
/.run/

# Deployment configuration: the real values stay local;
# etc/wenyuan.yaml.example is the checked-in template. The dated backups a
# deployment keeps beside it carry the same secrets and stay local too.
/etc/wenyuan.yaml
/etc/wenyuan.yaml.bak-*

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
.clean-room/
.codebuddy/
graphify-out/

# The scripts/ helpers are Python; running them leaves bytecode beside the
# sources, which is a byproduct rather than something to commit.
__pycache__/
*.pyc

# playwright-cli's browser-acceptance workspace (snapshots, console logs).
.playwright-cli/

# The client SDKs under clients/ each carry their own toolchain's build output:
# the npm install for the TypeScript generator, the Rust target directory, and
# Python's bytecode (covered above).
node_modules/
clients/rust/target/
clients/python/.venv/
*.bak

# The toolchain's module cache, when a session redirects GOPATH into the tree
# (`source .goenv.local` may point here on machines whose default cache is
# read-only). It is a dependency cache, never a source artifact.
/.gopath/
