# wenyuan environment variables (server, worker and bankctl).
#
# Copy this file to .env in the working directory and uncomment the lines you
# want; a discovered .env is authoritative over the already-exported
# environment, the reference's own entrypoint rule. Every line below is
# commented out, so copying the file changes nothing until you edit it.
#
# The same keys can be set in the YAML configuration file etc/wenyuan.yaml
# (spelled lowercased without the HINDSIGHT_API_ prefix, behind the process
# environment). docs/CONFIGURATION.md is the generated reference: every key
# with its reference default, and why a refused one is refused.

# HINDSIGHT_API_HOST=0.0.0.0
# HINDSIGHT_API_PORT=18888
# HINDSIGHT_API_LOG_LEVEL=info
# HINDSIGHT_API_ACCESS_LOG=false
# HINDSIGHT_API_WORKERS=1
# HINDSIGHT_API_BASE_PATH=
# HINDSIGHT_API_GZIP_MIN_SIZE=1024
# HINDSIGHT_API_PROFILE=
# HINDSIGHT_API_RUN_MIGRATIONS_ON_STARTUP=true
# HINDSIGHT_API_STORE_DOCUMENT_TEXT=true
# HINDSIGHT_API_LOG_FORMAT=text
# HINDSIGHT_API_LOG_JSON_FIELDS=
# HINDSIGHT_API_DAEMON_LOG=
# HINDSIGHT_API_MCP_AUTH_TOKEN=
# HINDSIGHT_API_MCP_STATELESS=false  # value-dependent, honoured as shown: the stateful streamable-HTTP transport is the only one implemented
# HINDSIGHT_API_MCP_ENABLED_TOOLS=all
# HINDSIGHT_API_MCP_INSTRUCTIONS=
# HINDSIGHT_API_ENABLE_DRY_RUN_EXTRACT=true
# HINDSIGHT_API_DEFAULT_BANK_TEMPLATE=  # value-dependent, honoured as shown: the value must be a JSON object
# HINDSIGHT_API_EXTENSION_PASSTHROUGH_HEADERS=
# HINDSIGHT_API_DATABASE_URL=pg0  # the reference's default is an embedded pg0 instance this build cannot manage; an unset URL refuses startup instead
# HINDSIGHT_API_DATABASE_SCHEMA=public
# HINDSIGHT_API_DB_POOL_MIN_SIZE=5
# HINDSIGHT_API_DB_POOL_MAX_SIZE=100
# HINDSIGHT_API_DATABASE_BACKEND=postgresql  # value-dependent, honoured as shown: only the PostgreSQL backend (and this build's in-memory one) is implemented; the reference's Oracle dialect is not
# HINDSIGHT_API_READ_DATABASE_URL=
# HINDSIGHT_API_READ_DB_POOL_MIN_SIZE=5
# HINDSIGHT_API_READ_DB_POOL_MAX_SIZE=100
# HINDSIGHT_API_MIGRATION_DATABASE_URL=
# HINDSIGHT_API_DB_COMMAND_TIMEOUT=60  # refused by this build: the per-command database timeout is not implemented
# HINDSIGHT_API_DB_ACQUIRE_TIMEOUT=30  # refused by this build: the connection-acquire timeout is not implemented
# HINDSIGHT_API_DB_POOL_SLOW_ACQUIRE_THRESHOLD_SECONDS=0.05  # refused by this build: the slow-acquire warning threshold is not implemented
# HINDSIGHT_API_DB_STATEMENT_TIMEOUT=600
# HINDSIGHT_API_DB_MAX_PARALLEL_WORKERS_PER_GATHER=
# HINDSIGHT_API_DB_SESSION_SETUP_ON_ACQUIRE=true  # value-dependent, honoured as shown: this build applies the session settings to every connection; turning per-acquire setup off is not implemented
# HINDSIGHT_API_DB_ACQUIRE_WARN_THRESHOLD_MS=1000  # refused by this build: the pool-acquire warning threshold is not implemented
# HINDSIGHT_API_MIGRATION_ISOLATION=false  # value-dependent, honoured as shown: this build migrates in-process; the reference's subprocess isolation is not implemented
# HINDSIGHT_API_MIGRATION_CONCURRENCY=1  # value-dependent, honoured as shown: this build migrates one schema at a time; the reference's concurrent tenant sweep is not implemented
# HINDSIGHT_API_MCP_ENABLED=true
# HINDSIGHT_API_ENABLE_BANK_CONFIG_API=true
# HINDSIGHT_API_ENABLE_BANK_LLM_HEALTH=false
# HINDSIGHT_API_ENABLE_FILE_UPLOAD_API=true
# HINDSIGHT_API_ENABLE_DOCUMENT_EXPORT_API=true
# HINDSIGHT_API_ENABLE_DOCUMENT_IMPORT_API=true
# HINDSIGHT_API_ENABLE_OBSERVATIONS=true
# HINDSIGHT_API_ENABLE_AUTO_CONSOLIDATION=true
# HINDSIGHT_API_ENABLE_OBSERVATION_HISTORY=true
# HINDSIGHT_API_ENABLE_MENTAL_MODEL_HISTORY=true
# HINDSIGHT_API_ENABLE_TEXT_SEARCH=true
# HINDSIGHT_API_ENABLE_TEMPORAL_RETRIEVAL=true
# HINDSIGHT_API_ENABLE_GRAPH_RETRIEVAL=true
# HINDSIGHT_API_ENABLE_RERANKING=true
# HINDSIGHT_API_GRAPH_RETRIEVER=link_expansion  # value-dependent, honoured as shown: only the link_expansion graph retriever is implemented
# HINDSIGHT_API_GRAPH_SEED_MIN_SIMILARITY=0.3
# HINDSIGHT_API_SEMANTIC_MIN_SIMILARITY=0.3
# HINDSIGHT_API_TEMPORAL_SEMANTIC_MIN_SIMILARITY=0.1
# HINDSIGHT_API_SEMANTIC_LINK_MIN_SIMILARITY=0.7
# HINDSIGHT_API_BM25_MIN_SCORE=0.0
