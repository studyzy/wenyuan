# HINDSIGHT_API_BM25_SELECTIVE_TERMS=true
# HINDSIGHT_API_LINK_EXPANSION_PER_ENTITY_LIMIT=200
# HINDSIGHT_API_LINK_EXPANSION_TIMEOUT=10
# HINDSIGHT_API_RECALL_CONNECTION_BUDGET=4  # refused by this build: the per-recall connection budget is not implemented
# HINDSIGHT_API_RECALL_MAX_QUERY_TOKENS=500
# HINDSIGHT_API_RECALL_DIAGNOSTIC_PHASES=true  # refused by this build: recall phase diagnostics are not implemented
# HINDSIGHT_API_RECALL_PHASE_SAMPLE_EVERY=1  # refused by this build: recall phase sampling is not implemented
# HINDSIGHT_API_RECALL_MAX_CONCURRENT=32
# HINDSIGHT_API_RECALL_INCLUDE_CHUNKS=true
