# Environment for wenyuan-frontend.service, installed to
# /etc/default/wenyuan-frontend. Edit that copy, then:
#   sudo systemctl restart wenyuan-frontend
#
# The console has no passphrase of its own. These two keys are the only
# credentials it knows, and each also signs a session cookie (operator key
# first, data key second), so rotating either one invalidates sessions:
#
#   WENYUAN_CP_DATAPLANE_API_KEY  the API's data key. Signing in with it opens
#                                 the console and the API with the same key.
#                                 Multi-tenant deployments ignore it, so
#                                 signing in with it is refused there and each
#                                 tenant uses its own wyk_... key.
#   WENYUAN_CP_ADMIN_API_KEY      the management plane's operator key. Only the
#                                 session it opens may manage tenants; a data
#                                 or tenant session gets 403 on /api/admin/**.

# Where the BFF routes find the API server.
WENYUAN_CP_DATAPLANE_API_URL=http://127.0.0.1:18888

# The API's data key. Empty means the frontend calls the API unauthenticated,
# which only works when the API has no key configured.
WENYUAN_CP_DATAPLANE_API_KEY=

# The management plane. Leave the key empty to run without tenant administration.
WENYUAN_CP_ADMIN_API_URL=http://127.0.0.1:18890
WENYUAN_CP_ADMIN_API_KEY=
